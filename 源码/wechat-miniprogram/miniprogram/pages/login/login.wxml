<view class="page login-page">
  <view class="login-brand-block">
    <image class="brand-image" src="/images/brand.png" mode="aspectFill" />
    <view class="login-brand-name">ADC 牙科连锁</view>
    <view class="login-brand-sub">Andrew’s Dental Chain</view>
    <view class="login-title">患者登录</view>
    <view class="login-desc">预约、支付、就诊记录与账单，仅对自己的患者档案开放。</view>
  </view>

  <view wx:if="{{error}}" class="notice" style="margin-bottom:16rpx">{{error}}</view>

  <view class="card login-panel">
    <view class="eyebrow">PATIENT PORTAL</view>
    <view class="login-panel-title">患者账号登录</view>
    <view class="login-panel-desc">使用诊所分配的患者账号和密码登录；没有账号可直接注册。</view>
    <view class="field"><view class="field-label">患者账号</view><input class="input" value="{{account}}" data-field="account" bindinput="input" placeholder="例如：P12345678" /></view>
    <view class="field"><view class="field-label">密码</view><input class="input" password value="{{password}}" data-field="password" bindinput="input" placeholder="请输入密码" /></view>
    <button class="btn" loading="{{loading}}" bindtap="patientLogin">登录患者端</button>
    <button class="btn ghost" style="margin-top:12rpx" bindtap="goRegister">还没有账号？注册患者账号</button>
    <view class="login-feature-row">
      <view class="login-feature"><view class="quick-symbol">约</view><view>预约挂号</view></view>
      <view class="login-feature"><view class="quick-symbol">付</view><view>预约金/余额</view></view>
      <view class="login-feature"><view class="quick-symbol">历</view><view>就诊记录</view></view>
    </view>
  </view>

  <view class="card staff-web-note">
    <view class="eyebrow">STAFF DESK</view>
    <view style="font-size:28rpx;font-weight:700;margin:8rpx 0 6rpx">员工请使用电脑端管理后台</view>
    <view class="small">员工端已从小程序移出，预约、排班、患者、退款、结算等由 Web 管理端统一控制。</view>
  </view>

  <view class="login-footer">ADC Dental Clinic Management System</view>
</view>
