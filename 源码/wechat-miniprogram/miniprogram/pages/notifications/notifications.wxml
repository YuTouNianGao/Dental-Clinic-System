<view class="page">
  <view class="hero"><view class="eyebrow">NOTIFICATIONS</view><view class="title">站内通知</view><view class="subtitle">通知仅作提醒，预约、支付和退款状态以业务记录为准。</view></view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="card"><view class="notice">{{error}}</view><button class="btn secondary" bindtap="load">重试</button></view>
  <view wx:elif="{{!items.length}}" class="card"><view class="empty">暂无通知</view></view>
  <view wx:for="{{items}}" wx:key="_id" class="card {{item.readAt ? '' : 'unread'}}" data-index="{{index}}" bindtap="read">
    <view class="row"><view style="font-size:29rpx;font-weight:700">{{item.title}}</view><view wx:if="{{!item.readAt}}" class="badge">未读</view></view>
    <view class="subtitle" style="margin-top:6rpx">{{item.body}}</view>
    <view class="small" style="margin-top:8rpx">{{item.timeLabel}}</view>
  </view>
</view>
