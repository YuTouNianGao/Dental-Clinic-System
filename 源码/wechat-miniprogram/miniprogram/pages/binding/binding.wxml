<view class="page">
  <view class="hero"><view class="eyebrow">PATIENT BINDING</view><view class="title">绑定已有患者档案</view><view class="subtitle">如果你在诊所已有就诊记录，可通过姓名和手机号申请绑定。员工核验后，历史记录会归入当前微信账号。</view></view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="card"><view class="notice">{{error}}</view><button class="btn secondary" bindtap="load">重试</button></view>
  <block wx:else>
    <view wx:if="{{binding && binding.status === 'PENDING_REVIEW'}}" class="card">
      <view class="badge amber">待审核</view>
      <view class="title" style="font-size:30rpx;margin-top:12rpx">绑定申请已提交</view>
      <view class="subtitle">目标档案：{{binding.patientName}} · {{binding.phone}}</view>
      <view class="small">提交时间：{{binding.timeLabel}}</view>
    </view>
    <view wx:elif="{{binding && binding.status === 'APPROVED'}}" class="card">
      <view class="badge">已绑定</view>
      <view class="title" style="font-size:30rpx;margin-top:12rpx">{{binding.patientName}}</view>
      <view class="subtitle">当前微信已关联该患者档案，历史就诊和账单已可查看。</view>
    </view>
    <view wx:elif="{{binding && binding.status === 'REJECTED'}}" class="card">
      <view class="badge red">未通过</view>
      <view class="title" style="font-size:30rpx;margin-top:12rpx">绑定申请未通过</view>
      <view class="subtitle">{{binding.reviewNote || '请核对姓名和手机号后重新提交。'}}</view>
    </view>
    <view class="card" wx:if="{{!binding || binding.status === 'REJECTED'}}">
      <view class="field"><view class="field-label">患者姓名</view><input class="input" value="{{name}}" data-field="name" bindinput="input" placeholder="与诊所档案一致" /></view>
      <view class="field"><view class="field-label">手机号</view><input class="input" type="number" value="{{phone}}" data-field="phone" bindinput="input" placeholder="与诊所档案一致" /></view>
      <view class="form-hint">演示档案：林可 / 13910001001；周宁 / 13910001002。</view>
      <button class="btn" style="margin-top:22rpx" loading="{{saving}}" bindtap="submit">提交绑定申请</button>
    </view>
  </block>
</view>
