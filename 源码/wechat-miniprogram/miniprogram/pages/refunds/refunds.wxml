<view class="page">
  <view class="hero"><view class="eyebrow">REFUNDS</view><view class="title">退款记录</view><view class="subtitle">患者提前 24 小时以上取消会生成退款申请；审核通过并处理后才算退款成功。</view></view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="card"><view class="notice">{{error}}</view><button class="btn secondary" bindtap="load">重试</button></view>
  <view wx:elif="{{!items.length}}" class="card"><view class="empty">暂无退款记录</view></view>
  <view wx:for="{{items}}" wx:key="_id" class="card">
    <view class="row"><view><view style="font-size:30rpx;font-weight:700">{{item.refundNo}}</view><view class="small">{{item.reasonText || item.reasonCode}} · {{item.timeLabel}}</view></view><view class="badge {{item.status === 'REJECTED' || item.status === 'FAILED' ? 'red' : item.status === 'SUCCEEDED' ? '' : 'amber'}}">{{item.statusLabel}}</view></view>
    <view class="amount" style="margin-top:14rpx">{{item.amountLabel}}</view>
    <view wx:if="{{item.reviewNote}}" class="small" style="margin-top:8rpx">审核备注：{{item.reviewNote}}</view>
  </view>
</view>
