<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="card"><view class="notice">{{error}}</view><button class="btn secondary" bindtap="load">重试</button></view>
  <block wx:else>
    <view class="hero">
      <view class="eyebrow">PATIENT ACCOUNT</view>
      <view class="title">{{user.displayName}}</view>
      <view class="subtitle">患者账号 · 仅本人数据</view>
    </view>
    <view class="card" wx:if="{{patient}}">
      <view class="eyebrow">PROFILE</view>
      <view style="font-size:32rpx;font-weight:700;margin:8rpx 0 16rpx">个人资料</view>
      <view class="info-row"><view class="info-label">患者账号</view><view class="info-value">{{user.account}}</view></view>
      <view class="info-row"><view class="info-label">姓名</view><view class="info-value">{{patient.name}}</view></view>
      <view class="info-row"><view class="info-label">性别</view><view class="info-value">{{genderLabel}}</view></view>
      <view class="info-row"><view class="info-label">年龄</view><view class="info-value">{{patient.age}} 岁</view></view>
      <view class="divider"></view>
      <view class="field"><view class="field-label">手机号</view><input class="input" value="{{form.phone}}" data-field="phone" bindinput="input" /></view>
      <view class="field"><view class="field-label">电子邮箱</view><input class="input" value="{{form.email}}" data-field="email" bindinput="input" /></view>
      <view class="field"><view class="field-label">账单地址</view><input class="input" value="{{form.billingAddress}}" data-field="billingAddress" bindinput="input" /></view>
      <view class="small">患者编号：{{patient.patientNo || patient._id}} · 姓名、性别、年龄由注册信息维护。</view>
      <button class="btn" style="margin-top:20rpx" loading="{{saving}}" bindtap="save">保存联系方式</button>
    </view>
    <view class="card">
      <view class="eyebrow">SERVICES</view>
      <view class="list-item" bindtap="goNotifications"><view class="row"><view>站内通知</view><view class="small">查看</view></view></view>
      <view class="list-item" bindtap="goRefunds"><view class="row"><view>退款记录</view><view class="small">查看</view></view></view>
      <view class="list-item" bindtap="goBinding"><view class="row"><view>绑定已有患者档案</view><view class="small">申请</view></view></view>
      <view class="list-item" bindtap="goClinics"><view class="row"><view>诊所与牙医</view><view class="small">查看</view></view></view>
      <view class="list-item" bindtap="logout"><view class="row"><view>退出登录</view><view class="small">退出</view></view></view>
    </view>
    <view class="card staff-web-note">
      <view class="eyebrow">STAFF DESK</view>
      <view style="font-size:27rpx;font-weight:700;margin:8rpx 0 6rpx">员工请使用电脑端管理后台</view>
      <view class="small">员工端已从小程序移出，预约、排班、患者、退款与结算由 Web 管理端统一控制。</view>
    </view>
  </block>
</view>
