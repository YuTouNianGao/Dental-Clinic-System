page {
  background: #f6f2ea;
  background-image: linear-gradient(180deg, #eef5ef 0%, #f6f2ea 34%, #f8f5ee 100%);
  color: #1d302d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
view, text, button, input, textarea, picker { box-sizing: border-box; }
button { font-family: inherit; }
.page { padding: 26rpx 28rpx 80rpx; }

/* ——— surfaces ——— */
.card {
  background: #fffdf9;
  border: 1rpx solid rgba(33, 72, 66, .07);
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 16rpx 44rpx rgba(22, 54, 48, .055);
}
.row { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.divider { height: 1rpx; background: #ebe7de; margin: 22rpx 0; }

/* ——— type ——— */
.muted { color: #73837d; font-size: 24rpx; }
.small { font-size: 22rpx; color: #7d8d87; line-height: 1.55; }
.title { font-size: 46rpx; font-weight: 800; letter-spacing: -1.4rpx; line-height: 1.22; }
.subtitle { font-size: 25rpx; color: #6e817b; line-height: 1.75; }
.eyebrow { color: #b78a45; font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; text-transform: uppercase; }
.hero .title { color: #fff; }
.hero .subtitle { color: #c9e3da; }

/* ——— buttons ——— */
.btn {
  border: none;
  border-radius: 18rpx;
  padding: 22rpx 30rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #fff;
  background: linear-gradient(135deg, #0f6b66, #168b80);
  box-shadow: 0 10rpx 24rpx rgba(15, 107, 102, .18);
}
.btn::after { border: none; }
.btn.secondary { background: #edf5f0; color: #0b4f4b; box-shadow: none; border: 1rpx solid #d7e8e1; }
.btn.ghost { background: transparent; color: #0f6b66; border: 1rpx solid #cfe1da; box-shadow: none; }
.btn.danger { background: #fbebe7; color: #bd4a3a; box-shadow: none; border: 1rpx solid #f1d5cd; }
.btn.small { padding: 12rpx 20rpx; font-size: 22rpx; border-radius: 999rpx; box-shadow: none; }
.btn[disabled] { opacity: .45; }

/* ——— badges ——— */
.badge { display: inline-block; padding: 7rpx 15rpx; border-radius: 999rpx; font-size: 20rpx; background: #e8f4ee; color: #0f6b66; }
.badge.red { background: #fbeae5; color: #bd4a3a; }
.badge.amber { background: #fbf0dc; color: #986919; }
.badge.gray { background: #eef0ec; color: #697773; }

/* ——— hero ——— */
.hero {
  position: relative;
  background: linear-gradient(138deg, #082f2d 0%, #0d504a 52%, #136e63 100%);
  color: #fff;
  border-radius: 36rpx;
  padding: 38rpx 34rpx 34rpx;
  margin-bottom: 22rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(11, 59, 56, .2);
}
.hero::before {
  content: "";
  position: absolute;
  width: 340rpx;
  height: 340rpx;
  border: 1rpx solid rgba(255,255,255,.12);
  border-radius: 50%;
  right: -140rpx;
  top: -170rpx;
}
.hero::after {
  content: "";
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(114, 211, 185, .18), transparent 68%);
  right: -40rpx;
  bottom: -100rpx;
}
.hero .eyebrow { color: #d9b16c; }
.hero .staff-entry {
  position: absolute; right: 24rpx; top: 22rpx;
  padding: 10rpx 18rpx; border: 1rpx solid rgba(255,255,255,.32);
  border-radius: 999rpx; color: #e2f3ee; font-size: 20rpx;
  background: rgba(255,255,255,.08); z-index: 2;
}
.hero-actions { display: flex; gap: 14rpx; margin-top: 26rpx; }
.hero-actions .btn { flex: 1; padding: 18rpx 16rpx; font-size: 25rpx; }
.hero-top { position: relative; display: flex; align-items: center; justify-content: space-between; margin-bottom: 26rpx; z-index: 2; }
.hero-brand { display: flex; align-items: center; gap: 12rpx; color: #d9eee7; font-size: 20rpx; letter-spacing: 2rpx; font-weight: 600; }
.hero-seal { width: 44rpx; height: 44rpx; border-radius: 14rpx; border: 1rpx solid rgba(255,255,255,.28); display: flex; align-items: center; justify-content: center; font-size: 18rpx; color: #f0d49c; font-weight: 700; }
.hero-role { padding: 8rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.1); color: #d9eee7; font-size: 19rpx; letter-spacing: 1rpx; }
.hero .btn.secondary { background: #f7f3e8; color: #0d4d48; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.12); border: none; }
.hero .btn.ghost { color: #e5f4ef; border-color: rgba(255,255,255,.3); background: rgba(255,255,255,.06); }
.hero-stats { display: flex; margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.14); }
.hero-stat { flex: 1; }
.hero-stat .num { font-size: 34rpx; font-weight: 800; color: #fff; }
.hero-stat .label { font-size: 20rpx; color: #a9cec5; margin-top: 4rpx; }

/* ——— quick actions ——— */
.quick-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-bottom: 4rpx; }
.quick-item {
  width: 23.5%; background: #fffdf9;
  border: 1rpx solid rgba(33,72,66,.06);
  border-radius: 22rpx; padding: 22rpx 8rpx 18rpx;
  text-align: center; box-shadow: 0 10rpx 28rpx rgba(22,54,48,.045);
  margin-bottom: 12rpx;
}
.quick-symbol {
  width: 58rpx; height: 58rpx; border-radius: 19rpx; margin: 0 auto 10rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 25rpx; font-weight: 700; color: #0f6b66; background: #e7f3ed;
}
.quick-item:nth-child(2) .quick-symbol { color: #9a6a12; background: #fbf0dc; }
.quick-item:nth-child(3) .quick-symbol { color: #356b9a; background: #eaf1f8; }
.quick-item:nth-child(4) .quick-symbol { color: #8a5a70; background: #f8edf2; }
.quick-label { font-size: 21rpx; color: #50635e; }

/* ——— sections ——— */
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 30rpx 4rpx 14rpx; }
.section-title { font-size: 31rpx; font-weight: 800; color: #1b302c; letter-spacing: -.5rpx; }
.section-title::before {
  content: ""; display: inline-block; width: 6rpx; height: 26rpx;
  background: #c49a54; border-radius: 4rpx; margin-right: 12rpx;
  vertical-align: -3rpx;
}
.section-link { font-size: 22rpx; color: #0f6b66; }

/* ——— metrics ——— */
.metric {
  background: #fffdf9; border: 1rpx solid rgba(33,72,66,.06);
  border-radius: 22rpx; padding: 22rpx;
}
.metric .num { font-size: 38rpx; font-weight: 800; color: #0e4b47; letter-spacing: -1rpx; }
.metric .label { font-size: 20rpx; color: #7d8d87; margin-top: 4rpx; }

/* ——— lists ——— */
.list-item { padding: 24rpx 0; border-bottom: 1rpx solid #efeae1; }
.list-item:last-child { border-bottom: none; }
.info-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f0ece4; font-size: 25rpx; }
.info-row:last-child { border-bottom: none; }
.info-label { color: #7d8d87; flex: 0 0 150rpx; }
.info-value { flex: 1; text-align: right; color: #1b302c; }

/* ——— forms ——— */
.field { margin-bottom: 20rpx; }
.field-label { font-size: 22rpx; color: #60736d; margin-bottom: 10rpx; display: block; }
.input {
  background: #faf8f3; border: 1rpx solid #e6e1d6; border-radius: 16rpx;
  padding: 21rpx 20rpx; width: 100%; min-height: 82rpx; color: #1b302c;
}
.form-hint { font-size: 21rpx; color: #7d8d87; line-height: 1.65; margin-top: 10rpx; }
.notice {
  background: #fdf6e7; border: 1rpx solid #f0dfb8; color: #7c5d21;
  border-radius: 18rpx; padding: 20rpx; font-size: 23rpx; line-height: 1.65;
}

/* ——— empty ——— */
.empty {
  text-align: center; color: #8b9a94; padding: 76rpx 20rpx; font-size: 23rpx;
  line-height: 1.7;
}

/* ——— chips / dates / slots ——— */
.chip-row { display: flex; gap: 12rpx; overflow-x: auto; white-space: nowrap; padding: 6rpx 0 10rpx; }
.chip { flex: 0 0 auto; padding: 14rpx 24rpx; border-radius: 999rpx; background: #fffdf9; border: 1rpx solid #e4ddd1; color: #687a74; font-size: 23rpx; }
.chip.active { background: #0f6b66; border-color: #0f6b66; color: #fff; box-shadow: 0 8rpx 18rpx rgba(15,107,102,.18); }
.date-strip { display: flex; gap: 12rpx; overflow-x: auto; white-space: nowrap; padding: 10rpx 0 14rpx; }
.date-chip { flex: 0 0 auto; width: 106rpx; padding: 16rpx 0; text-align: center; border-radius: 18rpx; background: #faf8f3; border: 1rpx solid #e6e1d6; }
.date-chip.active { background: linear-gradient(145deg, #0f6b66, #15877c); border-color: #0f6b66; color: #fff; box-shadow: 0 8rpx 18rpx rgba(15,107,102,.16); }
.date-chip .week { font-size: 19rpx; opacity: .7; display: block; }
.date-chip .day { font-size: 30rpx; font-weight: 800; display: block; margin-top: 4rpx; }
.slot-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 18rpx; }
.slot-grid .slot { width: 31.8%; margin-bottom: 12rpx; }
.slot { border: 1rpx solid #e5dfd3; border-radius: 16rpx; padding: 18rpx 8rpx; text-align: center; background: #fffdf9; color: #2d4640; }
.slot.active { background: linear-gradient(145deg, #0f6b66, #15877c); color: #fff; border-color: #0f6b66; box-shadow: 0 8rpx 18rpx rgba(15,107,102,.16); }
.slot-time { font-size: 27rpx; font-weight: 800; }
.slot-end { font-size: 19rpx; color: #8a9b96; margin-top: 2rpx; }
.slot.active .slot-end { color: #c7e6df; }

/* ——— appointment cards ——— */
.appt-card { padding: 26rpx 24rpx; }
.appt-date { font-size: 30rpx; font-weight: 800; letter-spacing: -.3rpx; }
.appt-clinic { font-size: 23rpx; color: #7d8d87; margin-top: 5rpx; }
.next-card { display: flex; align-items: center; gap: 20rpx; }
.date-tile { flex: 0 0 100rpx; width: 100rpx; height: 108rpx; border-radius: 22rpx; background: #0f6b66; color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.date-month { font-size: 28rpx; font-weight: 800; letter-spacing: -1rpx; }
.date-week { font-size: 18rpx; color: #c7e6df; margin-top: 4rpx; }
.next-info { flex: 1; min-width: 0; }
.next-title { font-size: 29rpx; font-weight: 800; }
.next-time { font-size: 23rpx; color: #0f6b66; font-weight: 600; margin: 5rpx 0; }
.care-card { background: linear-gradient(145deg, #fdf8ed, #f8f2e4); border-color: #efe0c6; }
.care-title { font-size: 29rpx; font-weight: 800; color: #3d3424; margin: 6rpx 0 16rpx; }
.tip-row { display: flex; gap: 14rpx; align-items: flex-start; font-size: 22rpx; color: #6f6250; line-height: 1.65; margin-bottom: 12rpx; }
.tip-index { flex: 0 0 auto; font-size: 18rpx; color: #a47a34; font-weight: 700; letter-spacing: 1rpx; margin-top: 3rpx; }
.status-line { display: flex; gap: 10rpx; align-items: center; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #0f6b66; }
.dot.amber { background: #d69a3f; } .dot.red { background: #bd4a3a; } .dot.gray { background: #96a6a2; }

/* ——— timeline / people ——— */
.timeline { padding-left: 34rpx; position: relative; }
.timeline:before { content: ""; position: absolute; left: 11rpx; top: 8rpx; bottom: 8rpx; width: 2rpx; background: #e5dfd3; }
.timeline-item { position: relative; padding-bottom: 24rpx; }
.timeline-item:last-child { padding-bottom: 0; }
.timeline-dot { position: absolute; left: -34rpx; top: 6rpx; width: 24rpx; height: 24rpx; border-radius: 50%; background: #fffdf9; border: 5rpx solid #0f6b66; box-sizing: border-box; }
.timeline-title { font-size: 25rpx; font-weight: 700; }
.timeline-text { font-size: 22rpx; color: #7d8d87; margin-top: 6rpx; line-height: 1.6; }
.avatar { width: 86rpx; height: 86rpx; border-radius: 26rpx; background: #e7f3ed; color: #0f6b66; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-weight: 800; }
.amount { font-size: 38rpx; font-weight: 800; color: #0e4b47; letter-spacing: -1rpx; }
.amount small { font-size: 21rpx; color: #7d8d87; font-weight: 400; margin-left: 8rpx; }
.grid2 { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid2 > view, .grid2 > button { width: 48.5%; margin-bottom: 12rpx; }
.grid3 { display: flex; flex-wrap: wrap; justify-content: space-between; }
.grid3 > view { width: 32%; margin-bottom: 8rpx; }
.panel-dark { background: #0b3b38; color: #fff; border-radius: 26rpx; padding: 26rpx; }
.panel-dark .muted { color: #a8cfc7; }
.panel-dark .title { color: #fff; }
.fab { position: fixed; right: 30rpx; bottom: 140rpx; z-index: 5; }
.pill-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.unread { border-left: 6rpx solid #0f6b66; }

/* ——— staff tiles ——— */
.tile-grid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 16rpx; }
.tile-grid .tile { width: 48.5%; margin-bottom: 14rpx; }
.tile { background: #faf8f3; border: 1rpx solid #eae4d9; border-radius: 22rpx; padding: 22rpx 18rpx; }
.tile .quick-symbol { margin: 0 0 12rpx; }
.tile-title { font-size: 26rpx; font-weight: 700; color: #1b302c; }
.tile-desc { font-size: 20rpx; color: #7d8d87; margin-top: 4rpx; }

/* ——— brand / login ——— */
.brand-image { width: 112rpx; height: 112rpx; border-radius: 30rpx; display: block; margin-bottom: 22rpx; box-shadow: 0 14rpx 30rpx rgba(11,59,56,.22); }
.login-page { padding-top: 36rpx; }
.login-brand-block { padding: 0 8rpx 28rpx; }
.login-brand-block .brand-image { width: 132rpx; height: 132rpx; border-radius: 36rpx; margin-bottom: 20rpx; }
.login-brand-name { font-size: 38rpx; font-weight: 800; letter-spacing: -1rpx; color: #1b302c; }
.login-brand-sub { font-size: 21rpx; color: #8b9b95; letter-spacing: 1rpx; margin-top: 4rpx; }
.login-title { font-size: 50rpx; font-weight: 800; letter-spacing: -2rpx; margin-top: 34rpx; line-height: 1.2; }
.login-desc { font-size: 23rpx; color: #788983; line-height: 1.7; margin-top: 10rpx; }
.role-switch { display: flex; justify-content: space-between; margin-bottom: 20rpx; }
.role-card { width: 48.5%; background: #fffdf9; border: 2rpx solid #eae4d9; border-radius: 26rpx; padding: 24rpx 18rpx; }
.role-card.active { border-color: #0f6b66; background: #f2faf6; box-shadow: 0 12rpx 28rpx rgba(15,107,102,.1); }
.role-icon { width: 58rpx; height: 58rpx; border-radius: 19rpx; background: #e7f3ed; color: #0f6b66; display: flex; align-items: center; justify-content: center; font-size: 25rpx; font-weight: 800; margin-bottom: 12rpx; }
.role-card.active .role-icon { background: #0f6b66; color: #fff; }
.role-title { font-size: 28rpx; font-weight: 700; }
.role-desc { font-size: 19rpx; color: #7d8d87; margin-top: 4rpx; }
.login-panel { padding: 30rpx; }
.login-panel-title { font-size: 34rpx; font-weight: 800; margin: 8rpx 0; }
.login-panel-desc { font-size: 23rpx; color: #788983; line-height: 1.7; margin-bottom: 24rpx; }
.login-feature-row { display: flex; justify-content: space-between; margin: 24rpx 0 28rpx; }
.login-feature { width: 31%; text-align: center; font-size: 20rpx; color: #60736d; }
.login-feature .quick-symbol { margin-bottom: 8rpx; }
.login-footer { text-align: center; color: #9aa8a2; font-size: 19rpx; margin: 30rpx 0 10rpx; letter-spacing: 1rpx; }
.staff-web-note { background: #fbf7ee; border-color: #ecdfc8; }

/* ——— booking ——— */
.step-head { display: flex; gap: 16rpx; align-items: center; margin-bottom: 18rpx; }
.step-no { width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #0f6b66; color: #fff; font-size: 21rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; }
.select-card { display: flex; align-items: center; justify-content: space-between; background: #faf8f3; border: 1rpx solid #e6e1d6; border-radius: 18rpx; padding: 22rpx; }
.select-title { font-size: 29rpx; font-weight: 700; }
.select-arrow { color: #0f6b66; font-size: 36rpx; }
.dept-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.dept-grid .dept-card { width: 31.8%; margin-bottom: 12rpx; }
.dept-card { border: 1rpx solid #e6e1d6; background: #faf8f3; border-radius: 18rpx; padding: 18rpx 8rpx; text-align: center; }
.dept-card.active { background: linear-gradient(145deg, #0f6b66, #15877c); border-color: #0f6b66; color: #fff; box-shadow: 0 8rpx 18rpx rgba(15,107,102,.16); }
.dept-short { font-size: 25rpx; font-weight: 800; }
.dept-name { font-size: 19rpx; margin-top: 6rpx; opacity: .75; }
.doctor-card { display: flex; align-items: center; gap: 16rpx; border: 1rpx solid #eae4d9; border-radius: 20rpx; padding: 18rpx; margin-bottom: 12rpx; background: #fffdf9; }
.doctor-card.active { border-color: #0f6b66; background: #f2faf6; }
.doctor-card .avatar { width: 76rpx; height: 76rpx; border-radius: 24rpx; font-size: 29rpx; flex: 0 0 auto; }
.doctor-name { font-size: 28rpx; font-weight: 700; }
.doctor-title { font-size: 20rpx; color: #7d8d87; font-weight: 400; margin-left: 8rpx; }
.doctor-check { width: 40rpx; height: 40rpx; border-radius: 50%; background: #0f6b66; color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.doctor-card:not(.active) .doctor-check { background: #eef0ec; }
